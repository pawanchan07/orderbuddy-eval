# ---------------------------------------------------------------
# Secrets — never commit. Broad by design: this repo is public, and
# a miss here is a credential leak, not a tidiness problem.
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
.netrc
.npmrc
secrets/
credentials*.json
*credentials*
*secret*
id_rsa*
*.token

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Caches
.cache/
data/hf_cache/
.embeddings_cache/

# Large / regenerable artifacts
data/interim/*.npy
data/raw/*.parquet

# OS
Thumbs.db
.DS_Store
